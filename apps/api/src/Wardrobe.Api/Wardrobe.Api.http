@Wardrobe.Api_HostAddress = http://localhost:5086
@Token = replace_with_access_token

GET {{Wardrobe.Api_HostAddress}}/api/health
Accept: application/json

###

GET {{Wardrobe.Api_HostAddress}}/api/v1/categories
Accept: application/json

###

GET {{Wardrobe.Api_HostAddress}}/api/v1/colors
Accept: application/json

###

GET {{Wardrobe.Api_HostAddress}}/api/v1/me
Authorization: Bearer {{Token}}
Accept: application/json

###

GET {{Wardrobe.Api_HostAddress}}/api/v1/items/summary
Authorization: Bearer {{Token}}
Accept: application/json

###
